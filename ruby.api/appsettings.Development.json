{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=ruby;Username=postgres;Password=aws-secrets-manager-ruby-db-password;"
  },
  "DatabaseConnection": {
    "Host": "localhost",
    "Port": 5432,
    "Database": "ruby",
    "Username": "postgres",
    "Password": "aws-secrets-manager-ruby-db-password"
  },
  "RootConfiguration": {
    "MigrationPath": "MigrationScripts"
  },
  "Authentication": {
    "Google": {
      "ClientId": "your-google-client-id.apps.googleusercontent.com"
    }
  },
  "Jwt": {
    "Key": "aws-secrets-manager-ruby-jwt-key",
    "Issuer": "aws-secrets-manager-ruby-jwt-issuer",
    "Audience": "aws-secrets-manager-ruby-jwt-audience"
  },
  "AWS": {
    "Region": "us-east-1",
    "SecretsManager": {
      "SecretId": "ruby/dev/database"
    }
  }
}
